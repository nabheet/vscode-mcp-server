{
  "name": "vscode-ide-mcp",
  "displayName": "MCP Server for VS Code",
  "description": "MCP server that lets AI agents (opencode, Claude, Cursor) debug, edit, and control VS Code directly. Debugger, terminal, LSP, file ops.",
  "version": "0.3.38",
  "publisher": "nabheet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nabheet/vscode-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/nabheet/vscode-mcp-server/issues"
  },
  "homepage": "https://github.com/nabheet/vscode-mcp-server#readme",
  "engines": {
    "vscode": "^1.134.0"
  },
  "icon": "icon.png",
  "categories": [
    "Debuggers",
    "AI",
    "Programming Languages"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "ai",
    "agent",
    "coding assistant",
    "vscode",
    "debug",
    "debugger",
    "lsp",
    "remote",
    "automation",
    "tool server",
    "terminal"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "VS Code MCP Server",
      "properties": {
        "vscode-mcp-server.port": {
          "type": "number",
          "default": 6010,
          "description": "Base port for the MCP HTTP server. The first VS Code window becomes the cluster master and owns this port; other windows join as workers on the same port."
        },
        "vscode-mcp-server.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token. Clients must send Authorization: Bearer <token>. Empty string = no auth."
        },
        "vscode-mcp-server.tlsCertPath": {
          "type": "string",
          "default": "",
          "description": "Path to TLS certificate PEM file. Requires tlsKeyPath. Enables HTTPS."
        },
        "vscode-mcp-server.tlsKeyPath": {
          "type": "string",
          "default": "",
          "description": "Path to TLS private key PEM file. Requires tlsCertPath. Enables HTTPS."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && markdownlint-cli2",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix",
    "check": "npm run typecheck && npm run lint",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "RUN_E2E=1 vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "RUN_E2E=1 vitest --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.1",
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
